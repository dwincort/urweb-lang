{
  "name": "urweb-lang",
  "displayName": "urweb-language",
  "description": "Syntax highlighting and code navigation for Ur/Web",
  "version": "0.2.0",
  "license": "MIT",
  "publisher": "DanWC",
  "engines": {
    "vscode": "^1.83.0"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/dwincort/urweb-lang.git"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:ur",
    "onLanguage:urs"
  ],
  "contributes": {
    "commands": [
      {
        "command": "urweb.restartServer",
        "title": "Restart Language Server",
        "category": "Ur/Web"
      }
    ],
    "configuration": {
      "title": "Ur/Web",
      "properties": {
        "urweb.server.path": {
          "type": "string",
          "default": "urweb",
          "markdownDescription": "Path to the `urweb` executable used to start the language server. Defaults to `urweb` on your `PATH`."
        },
        "urweb.server.args": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["-startLspServer"],
          "description": "Arguments passed to the urweb executable to start the language server."
        },
        "urweb.rootMarkers": {
          "type": "array",
          "items": { "type": "string" },
          "default": [".git"],
          "markdownDescription": "File or directory names that mark a project root. The language server is started in the closest ancestor directory of an Ur/Web file containing one of these. If none is found, the workspace folder is used."
        },
        "urweb.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace the communication between VS Code and the Ur/Web language server."
        }
      }
    },
    "languages": [{
      "id": "ur",
      "aliases": ["UrWeb", "ur"],
      "extensions": [".ur"],
      "configuration": "./language-configuration.json",
      "icon": {
        "light": "./icons/ur.png",
        "dark": "./icons/ur.png"
      }
    },{
      "id": "urs",
      "aliases": ["UrWebSignature", "urs"],
      "extensions": [".urs"],
      "configuration": "./language-configuration.json",
      "icon": {
        "light": "./icons/urs.png",
        "dark": "./icons/urs.png"
      }
    },{
      "id": "urp",
      "aliases": ["UrWebProject", "urp"],
      "extensions": [".urp"],
      "configuration": "./language-configuration-urp.json",
      "icon": {
        "light": "./icons/urp.png",
        "dark": "./icons/urp.png"
      }
    }],
    "grammars": [{
      "language": "ur",
      "scopeName": "source.ur",
      "path": "./syntaxes/urweb.tmLanguage"
    },{
      "language": "urs",
      "scopeName": "source.ur",
      "path": "./syntaxes/urweb.tmLanguage"
    },{
      "scopeName": "urweb.html.injection",
      "path": "./syntaxes/urweb-html-injection.tmLanguage.json",
      "injectTo": ["source.ur"],
      "embeddedLanguages": {
        "source.ur": "ur"
      }
    },{
      "language": "urp",
      "scopeName": "source.urp",
      "path": "./syntaxes/urwebproj.tmLanguage"
    }],
    "snippets": [{
      "language": "ur",
      "path": "./snippets/urweb-snippets.json"
    }]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.83.0",
    "typescript": "^5.0.0"
  }
}
